{%- for tp0 in type_declaration %}
      {%- for tp1 in type_declaration[tp0]["pages"] %}
            <div class="settings-section" id="{{tp0}}-{{tp1}}">
                <div class="settings-group-title-label">
                    {%- if type_declaration[tp0]["pages"][tp1]["title"] == "General" %}
                    {{type_declaration[tp0]["title"]}}
                    {%- else %}
                    {{type_declaration[tp0]["title"]}}: {{type_declaration[tp0]["pages"][tp1]["title"]}}
                    {%- endif %}
                    {%- if type_declaration[tp0]["pages"][tp1]["docLink"] %}
                    <i class="codicon codicon-question help-icon-button" onclick="window.open('{{type_declaration[tp0]["pages"][tp1]["docLink"]}}', '_blank')" title="Go To Documentation"></i>
                    {%- endif %}
                </div>
                <div class="settings-group-description">{{type_declaration[tp0]["pages"][tp1]["description"]}}</div>
                
                {%- for tp2 in type_declaration[tp0]["pages"][tp1] %}
                  {# Options #}
                  {%- if "options" in type_declaration[tp0]["pages"][tp1][tp2] %}
                    <div class="setting-item">
                        <div class="setting-item-label">
                            {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                            <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                        </div>
                        <div class="select-container">
                            <select class="setting-select-box" id="{{tp0}}-{{tp1}}-{{tp2}}">
                                    {%- for option in type_declaration[tp0]["pages"][tp1][tp2]["options"] %}
                                      <option value='{{option}}'>{{type_declaration[tp0]["pages"][tp1][tp2]["options"][option]}}</option>
                                    {%- endfor %}
                            </select>
                        </div>
                    </div>
                  {# Boolean #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "boolean" %}
                    <div class="setting-item">
                        <div class="setting-checkbox">
                            <input type="checkbox" id="{{tp0}}-{{tp1}}-{{tp2}}">
                            <label class="setting-checkbox-label" for="{{tp0}}-{{tp1}}-{{tp2}}">
                                {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                                <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                            </label>
                        </div>
                    </div>
                  {# String #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "string" %}
                    <div class="setting-item">
                        <div class="setting-item-label">
                            {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                            <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                        </div>
                        {%- if type_declaration[tp0]["pages"][tp1][tp2]["disabled"] == true %}
                            <input class="setting-input-box" id="{{tp0}}-{{tp1}}-{{tp2}}" value="{{type_declaration[tp0]['pages'][tp1][tp2]['value']}}" disabled>
                        {%- else %}
                            <input class="setting-input-box" id="{{tp0}}-{{tp1}}-{{tp2}}" value="{{type_declaration[tp0]['pages'][tp1][tp2]['value']}}">
                        {%- endif %}
                    </div>
                  {# Number #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "number" %}
                    <div class="setting-item">
                        <div class="setting-item-label">
                            {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                            <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                        </div>
                        <input type="number" class="setting-number-input" id="{{tp0}}-{{tp1}}-{{tp2}}">
                    </div>
                  {# Divider #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "divider" %}
                    <hr class="setting-divider">
                    <div class="setting-divider-title">{{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}</div>
                    <hr class="setting-divider">
                  {# Array #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "array" %}
                    <div class="setting-item">
                        <div class="setting-item-label">
                            {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                            <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                        </div>
                        <div class="setting-item-description">Comma separated values</div>
                        <input class="setting-input-box" id="{{tp0}}-{{tp1}}-{{tp2}}">
                    </div>
                  {# Table #}
                  {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "table" %}
                    <div class="setting-item">
                        <div class="setting-item-label">
                            {{type_declaration[tp0]["pages"][tp1][tp2]["description"]}}
                            <span class="markConfig" id="mark_{{tp0}}-{{tp1}}-{{tp2}}"></span>
                        </div>
                        <table class="setting-table" id="{{tp0}}-{{tp1}}-{{tp2}}">
                            <thead>
                                <tr>
                                    {%- for column in type_declaration[tp0]["pages"][tp1][tp2]["columns"] %}
                                    <th data-column="{{column}}">{{column|capitalize}}</th>
                                    {%- endfor %}
                                    <th class="setting-table-action-column"></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <button type="button" class="setting-button secondary setting-table-add-button" onclick="add_table_row('{{tp0}}-{{tp1}}-{{tp2}}')">
                            <i class="codicon codicon-add"></i>
                            Add row
                        </button>
                    </div>
                  {%- endif %}
                {%- endfor %}
            </div>
      {%- endfor %}
{%- endfor %}

<div class="settings-buttons">
    <button type="button" class="setting-button danger" onclick="close_panel(event)">
        <i class="codicon codicon-close"></i>
        Close
    </button>
    <button type="button" class="setting-button secondary" onclick="send_config(event)">
        <i class="codicon codicon-check"></i>
        Apply
    </button>
    <button type="button" class="setting-button primary" onclick="send_config_and_close(event)">
        <i class="codicon codicon-check-all"></i>
        Apply and Close
    </button>
</div>
  // VSCode Settings Style JavaScript
  
  function enable_tab(tp0, tp1){
    // Hide all sections
{%- for tp0 in type_declaration %}
    {%- for tp1 in type_declaration[tp0]["pages"] %}
    document.getElementById("{{tp0}}-{{tp1}}").classList.remove('active');
    {%- endfor %}
{%- endfor %}
    
    // Show the selected section
    document.getElementById(tp0 + "-" + tp1).classList.add('active');
    
    // Update sidebar selection
    updateSidebarSelection(tp0, tp1);
  }

  function updateSidebarSelection(tp0, tp1) {
    // Remove all selections
{%- for tp0 in type_declaration %}
    document.getElementById("btn-{{tp0}}-general").classList.remove('selected');
    {%- for tp1 in type_declaration[tp0]["pages"] %}
        {%- if tp1 != "general" %}
    if (document.getElementById("btn-{{tp0}}-{{tp1}}")) {
        document.getElementById("btn-{{tp0}}-{{tp1}}").classList.remove('selected');
    }
        {%- endif %}
    {%- endfor %}
{%- endfor %}
    
    // Add selection to current item
    if (tp1 === "general") {
        document.getElementById("btn-" + tp0 + "-general").classList.add('selected');
    } else {
        document.getElementById("btn-" + tp0 + "-" + tp1).classList.add('selected');
    }
  }

  function toggleSidebarSection(tp0) {
    // Functionality disabled - sections should always remain open
    return;
  }

  // Initialize
  enable_tab('general', 'general');

  // Add event listeners for sidebar
{%- for tp0 in type_declaration %}
  document.getElementById("btn-{{tp0}}-general").addEventListener("click", function(e) {
    e.preventDefault();
    enable_tab("{{tp0}}", "general");
  });

    {%- for tp1 in type_declaration[tp0]["pages"] %}
        {%- if tp1 != "general" %}
  if (document.getElementById("btn-{{tp0}}-{{tp1}}")) {
    document.getElementById("btn-{{tp0}}-{{tp1}}").addEventListener("click", function(e) {
      e.preventDefault();
      enable_tab("{{tp0}}", "{{tp1}}");
    });
  }
        {%- endif %}
    {%- endfor %}
{%- endfor %}
  
  const vscode = acquireVsCodeApi();

  function send_config_and_close(){
    const config = get_config();

    vscode.postMessage({
        command: 'set_config_and_close',
        config : config
    });
  }

  function send_config(){
    const config = get_config();

    vscode.postMessage({
        command: 'set_config',
        config : config
    });
  }

  function close_panel(){
    vscode.postMessage({
        command: 'close'
    });
  }

  function export_config(){
    vscode.postMessage({
        command: 'export'
    });
  }

  function load_config(){
    vscode.postMessage({
        command: 'load'
    });
  }

  window.addEventListener('message', event => {
      const message = event.data;
      switch (message.command) {
          case 'set_config':
              set_config(message.config);
              set_mark(message.diff_config, message.projectName);
              document.getElementById("configTitle").innerHTML = message.title;
              const tool = message.tool;
              if (tool != undefined && tool != ""){
                enable_tab("tools", tool);
              }
              break;
      }
  });

  function get_config(){
    const config = {};
    let element_value;
{%- for tp0 in type_declaration %}
    config["{{tp0}}"] = {}
    {%- for tp1 in type_declaration[tp0]["pages"] %}
    config["{{tp0}}"]["{{tp1}}"] = {}
        {%- for tp2 in type_declaration[tp0]["pages"][tp1] %}
            {%- if tp2 != "title" and tp2 != "description" and tp2 != "docLink"%}
                {%- if type_declaration[tp0]["pages"][tp1][tp2]["type"] == "boolean" %}
    element_value = document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").checked;
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "array" %}
    element_value = document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").value.split(',');
    if (element_value.length == 1 && element_value[0] == "") {
      element_value = [];
    }
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "table" %}
    element_value = get_table_value("{{tp0}}-{{tp1}}-{{tp2}}");
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "divider" %}
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "number" %}
    element_value = parseInt(document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").value, 10);
                {%- else %}
    element_value = document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").value;
                {%- endif %}
    config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] = element_value
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
{%- endfor %}
    return config;
  }

  function set_config(config){
{%- for tp0 in type_declaration %}
    {%- for tp1 in type_declaration[tp0]["pages"] %}
        {%- for tp2 in type_declaration[tp0]["pages"][tp1] %}
            {%- if tp2 != "title" and tp2 != "description" and tp2 != "docLink"%}
                {%- if type_declaration[tp0]["pages"][tp1][tp2]["type"] == "boolean" %}
    if (config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
        document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").checked = config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"];
    }
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "array" %}
    if (config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
        element_value = document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").value = String(config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"]);
    }
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "table" %}
    if (config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
        set_table_value("{{tp0}}-{{tp1}}-{{tp2}}", config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"]);
    }
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "divider" %}
                {%- else %}
    if (config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
        document.getElementById("{{tp0}}-{{tp1}}-{{tp2}}").value = config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"];
    }
                {%- endif %}
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
{%- endfor %}
  }

  function set_mark(config, projectName){
    const MODIFIEDMSG = "Modified in project";
    let mark = "";
{%- for tp0 in type_declaration %}
    {%- for tp1 in type_declaration[tp0]["pages"] %}
        {%- for tp2 in type_declaration[tp0]["pages"][tp1] %}
            {%- if tp2 != "title" and tp2 != "description" and tp2 != "docLink" %}
                {%- if type_declaration[tp0]["pages"][tp1][tp2]["type"] == "boolean" %}
    mark = "";
    if (projectName !== undefined && config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
      mark = MODIFIEDMSG;
    }
    document.getElementById("mark_{{tp0}}-{{tp1}}-{{tp2}}").innerHTML = mark;
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "array" %}
    mark = "";
    if (projectName !== undefined && config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
      mark = MODIFIEDMSG;
    }
    document.getElementById("mark_{{tp0}}-{{tp1}}-{{tp2}}").innerHTML = mark;
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "table" %}
    mark = "";
    if (projectName !== undefined && config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
      mark = MODIFIEDMSG;
    }
    document.getElementById("mark_{{tp0}}-{{tp1}}-{{tp2}}").innerHTML = mark;
                {%- elif type_declaration[tp0]["pages"][tp1][tp2]["type"] == "divider" %}
                {%- else %}
    mark = "";
    if (projectName !== undefined && config["{{tp0}}"] && config["{{tp0}}"]["{{tp1}}"] && config["{{tp0}}"]["{{tp1}}"]["{{tp2}}"] !== undefined) {
      mark = MODIFIEDMSG;
    }
    document.getElementById("mark_{{tp0}}-{{tp1}}-{{tp2}}").innerHTML = mark;
                {%- endif %}
            {%- endif %}
        {%- endfor %}
    {%- endfor %}
{%- endfor %}
  }

  function get_table_columns(table_id) {
    const table = document.getElementById(table_id);
    const columns = [];
    Array.from(table.tHead.rows[0].cells).forEach((cell) => {
      if (cell.dataset.column !== undefined) {
        columns.push(cell.dataset.column);
      }
    });
    return columns;
  }

  function add_table_row(table_id) {
    const table = document.getElementById(table_id);
    const columns = get_table_columns(table_id);
    const row = table.tBodies[0].insertRow();
    columns.forEach((column) => {
      const cell = row.insertCell();
      const input = document.createElement("input");
      input.className = "setting-input-box";
      input.setAttribute("data-column", column);
      cell.appendChild(input);
    });
    const action_cell = row.insertCell();
    const remove_button = document.createElement("button");
    remove_button.type = "button";
    remove_button.className = "setting-button danger setting-table-remove-button";
    remove_button.title = "Remove row";
    remove_button.innerHTML = '<i class="codicon codicon-trash"></i>';
    remove_button.onclick = function () { remove_table_row(remove_button); };
    action_cell.appendChild(remove_button);
  }

  function remove_table_row(button) {
    button.closest("tr").remove();
  }

  function get_table_value(table_id) {
    const table = document.getElementById(table_id);
    const columns = get_table_columns(table_id);
    const value = [];
    Array.from(table.tBodies[0].rows).forEach((row) => {
      const entry = {};
      Array.from(row.cells).forEach((cell, index) => {
        const input = cell.getElementsByTagName("input")[0];
        if (input !== undefined && columns[index] !== undefined) {
          entry[columns[index]] = input.value;
        }
      });
      value.push(entry);
    });
    return value;
  }

  function set_table_value(table_id, value) {
    const table = document.getElementById(table_id);
    const columns = get_table_columns(table_id);
    table.tBodies[0].innerHTML = "";
    if (Array.isArray(value)) {
      value.forEach((entry) => {
        add_table_row(table_id);
        const rows = table.tBodies[0].rows;
        const row = rows[rows.length - 1];
        columns.forEach((column, index) => {
          if (entry[column] !== undefined) {
            row.cells[index].getElementsByTagName("input")[0].value = entry[column];
          }
        });
      });
    }
  }

  function open_submenu_icon(x) {
    x.classList.toggle("change");
  }

